{
  "expo": {
    "name": "CivilAid",
    "slug": "civilaid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "civilaid",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.civilaid.app"
    },
    "android": {
      "package": "com.civilaid.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/icon-foreground.png",
        "monochromeImage": "./assets/brand/icon-monochrome.png",
        "backgroundColor": "#1E5EFF"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-mark.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/brand/splash-mark-dark.png",
            "backgroundColor": "#0A1330"
          }
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
